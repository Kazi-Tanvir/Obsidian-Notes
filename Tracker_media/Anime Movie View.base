views:
  - type: cards
    name: All Anime Movies
    filters:
      and:
        - file.folder == "movies"
        - subType == "anime-movie"
    order:
      - file.name
    cardSize: 150
    image: note.image
    imageAspectRatio: 1.5
    properties:
      - episodes
      - duration
    fields:
      - episodes
      - duration
  - type: cards
    name: Plan to Watch
    filters:
      and:
        - file.folder == "movies"
        - subType == "anime-movie"
        - status == "Plan to Watch"
    order:
      - file.name
    cardSize: 150
    image: note.image
    imageAspectRatio: 1.5
    properties:
      - episodes
      - duration
    fields:
      - episodes
      - duration
  - type: cards
