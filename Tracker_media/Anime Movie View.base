    order:
      - file.name
    cardSize: 150
    image: note.image
    imageAspectRatio: 1.5
    properties:
      - episodes
      - duration
    fields:
      - episodes
      - duration
  - type: cards
    name: All Anime Movies 2
    filters:
      and:
        - file.folder == "movies"
        - subType == "anime-movie"
