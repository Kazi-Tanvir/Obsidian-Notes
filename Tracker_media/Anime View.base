views:
  - type: cards
    name: All Anime
    filters:
      and:
        - file.folder == "anime"
    order:
      - file.name
    cardSize: 150
    image: note.image
    imageAspectRatio: 1.5
    properties:
      - episodes
      - duration
    fields:
      - episodes
      - duration
  - type: cards
    name: Plan to Watch
    filters:
      and:
        - file.folder == "anime"
        - status == "Plan to Watch"
    order:
      - file.name
    cardSize: 150
    image: note.image
    imageAspectRatio: 1.5
    properties:
      - episodes
      - duration
    fields:
      - episodes
      - duration
  - type: cards
    name: Currently Watching
    filters:
      and:
        - file.folder == "anime"
        - status == "Currently Watching"
    order:
      - file.name
    cardSize: 150
    image: note.image
    imageAspectRatio: 1.5
    properties:
      - episodes
      - duration
    fields:
      - episodes
      - duration
  - type: cards
    name: On Hold
    filters:
      and:
        - file.folder == "anime"
        - status == "On Hold"
    order:
      - file.name
    cardSize: 150
    image: note.image
    imageAspectRatio: 1.5
    properties:
      - episodes
      - duration
    fields:
      - episodes
      - duration
  - type: cards
    name: Dropped
    filters:
      and:
        - file.folder == "anime"
        - status == "Dropped"
    order:
      - file.name
    cardSize: 150
    image: note.image
    imageAspectRatio: 1.5
    properties:
      - episodes
      - duration
    fields:
      - episodes
      - duration
